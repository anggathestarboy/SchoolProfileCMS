APP_NAME=draftCMS
APP_ENV=staging
APP_KEY=base64:PIXPZCkrTlZVJluyxtvcGxwDt+2YGySV5aBg8vORJVU=
APP_DEBUG=false
APP_URL=http://localhost:8099

CMS_ENABLED=true
CMS_ROUTE=admin-panel

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# "db" is the MySQL service name in docker-compose.yml, not a real host.
# DB_USERNAME must NOT be "root" — the mysql image's MYSQL_USER refuses
# that value (root is already managed separately via MYSQL_ROOT_PASSWORD,
# which docker-compose.yml also sets from DB_PASSWORD below).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=draftcms
DB_USERNAME=draftcms
DB_PASSWORD=JHl8h1My9MmQQU2

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ACTIVITY_LOG_ENABLED=false

RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6LdrKs4tAAAAAK5JN2blIFz9lav1c8B0Z1yKA3UX
RECAPTCHA_SECRET_KEY=6LdrKs4tAAAAAEHIHwZ0gSYvb0jJUKP13gLsdrd9
RECAPTCHA_SCORE_THRESHOLD=0.5

# The host port docker-compose publishes the app on — http://localhost:8080.
# Only takes effect because every docker compose command is run with
# --env-file .env.docker (see README's Docker section); the plain env_file:
# list in docker-compose.yml can't feed this on its own, since port mapping
# is resolved before any container's env is even read.
APP_PORT=8099

# The "db" service's own MySQL init vars (docker-compose.yml gives db this
# same env_file) — kept in sync with DB_DATABASE/DB_USERNAME/DB_PASSWORD
# above by hand, since MySQL's official image and Laravel each expect
# differently-named variables for the same values. Changing DB_PASSWORD
# above without also changing these two would break the connection.
MYSQL_DATABASE=draftcms
MYSQL_USER=draftcms
MYSQL_PASSWORD=JHl8h1My9MmQQU2
MYSQL_ROOT_PASSWORD=JHl8h1My9MmQQU2

# First-boot admin/site bootstrap (see docker/entrypoint.sh, which calls
# `draft:setup` with these on every container start — a no-op after the
# first successful run, since draft:setup skips once any user exists).
# Change these before your first `docker compose up -d` if you want
# something other than the defaults; editing them after the first boot has
# no effect unless the database is wiped (e.g. `docker compose down -v`).
DRAFT_ADMIN_NAME=DraftCMS
DRAFT_ADMIN_EMAIL=draft@draft.com
DRAFT_ADMIN_PASSWORD=draft2026!
DRAFT_SITE_NAME=Indoneisa
DRAFT_SITE_HANDLE=indonesia
